# ================================================================
# Docker Compose Environment Variables
# ================================================================

# Database Configuration
DB_USERNAME=sa
DB_PASSWORD=

# ================================================================
# SERVICE URLs (Internal Docker network)
# ================================================================
# These URLs are used for communication between services inside Docker.
# Each service is accessible by its container name and port.
# ================================================================
FLEETS_SERVICE_URL=http://fleets-service:8081
ROUTES_SERVICE_URL=http://routes-service:8082
AUTH_SERVICE_URL=http://auth-service:8083
PACKAGES_SERVICE_URL=http://packages-service:8084
GEOCODING_SERVICE_URL=http://geocoding-service:8085

# ================================================================
# KEYCLOAK CONFIGURATION (External)
# ================================================================
# External Keycloak provider (UTN labs).
# Used for authentication and JWT validation.
# ================================================================
KEYCLOAK_URI=https://labsys.frc.utn.edu.ar/aim
KEYCLOAK_REALM=dds-materia
KEYCLOAK_JWKS_URI=${KEYCLOAK_URI}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs

# ================================================================
# KEYCLOAK CLIENT CREDENTIALS
# ================================================================
# Client ID and secret for the application in Keycloak.
# Used by ms-auth for user authentication and token management.
# ================================================================
KEYCLOAK_CLIENT_ID=tpi-dds-client
KEYCLOAK_CLIENT_SECRET=tpi-dds-client

# ================================================================
# KEYCLOAK ADMIN CREDENTIALS
# ================================================================
# Admin credentials for Keycloak management operations.
# Used by ms-auth to create users and assign roles.
# ================================================================
KEYCLOAK_ADMIN_USER=Dds-admin
KEYCLOAK_ADMIN_PASSWORD=dds12345

# ================================================================
# OSRM (Routing Engine)
# ================================================================
# URL for OSRM API - public instance for development.
# For production, use a local instance or commercial API.
# ================================================================
OSRM_URL=http://router.project-osrm.org

# ================================================================
# SPRING PROFILES
# ================================================================
# Active profile for Docker environment.
# Overrides application.yml settings when running in containers.
# ================================================================
SPRING_PROFILES_ACTIVE=docker