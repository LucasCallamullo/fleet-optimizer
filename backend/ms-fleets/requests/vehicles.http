### ============================================================
### VEHICLE API - HTTP Requests
### ============================================================
### 
### Base URL: http://localhost:8080/api/v1/vehicles
### 
### ============================================================

### Variables
@baseUrl = http://localhost:8080
@vehiclesUrl = {{baseUrl}}/api/v1/vehicles

### 
@authBaseUrl = {{baseUrl}}/api/v1/auth


### ================================================================
### 1. LOGIN - Regular User
### ================================================================
# @name loginUser
POST {{authBaseUrl}}/login
Content-Type: application/json

{
    "email": "user_regular@gmail.com",
    "password": "pass1234"
}

### 
@accessToken = {{loginUser.response.body.accessToken}}
@userRefreshToken = {{loginUser.response.body.refreshToken}}

### ============================================================
### 1. GET ALL VEHICLES (Basic - only category ID)
### ============================================================
GET {{vehiclesUrl}}
Accept: application/json
Authorization: Bearer {{accessToken}}

### ============================================================
### 2. GET ALL VEHICLES DETAILED (with full category)
### ============================================================
GET {{vehiclesUrl}}/detailed
Accept: application/json
Authorization: Bearer {{accessToken}}

### ============================================================
### 3. GET VEHICLE BY ID (with full category)
### ============================================================
### @prompt vehicleId Enter vehicle ID:
GET {{vehiclesUrl}}/2
Accept: application/json
Authorization: Bearer {{accessToken}}

### ============================================================
### 4. GET VEHICLE BY LICENSE PLATE (with full category)
### ============================================================
### @prompt licensePlate Enter license plate (e.g., ABC123):
GET {{vehiclesUrl}}/license/ABC123
Accept: application/json
Authorization: Bearer {{accessToken}}

### ============================================================
### 5. GET VEHICLES BY CATEGORY ID
### ============================================================
### @prompt categoryId Enter category ID:
GET {{vehiclesUrl}}/category/1
Accept: application/json
Authorization: Bearer {{accessToken}}

### ============================================================
### 6. CREATE VEHICLE (POST)
### ============================================================
POST {{vehiclesUrl}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessToken}}

{
  "licensePlate": "ABC123",
  "year": 2023,
  "categoryId": 1
}

### ============================================================
### 7. CREATE VEHICLE - With different data
### ============================================================
POST {{vehiclesUrl}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessToken}}

{
  "licensePlate": "XYZ789",
  "year": 2024,
  "categoryId": 2
}

### ============================================================
### 8. CREATE VEHICLE - Without category
### ============================================================
POST {{vehiclesUrl}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessToken}}

{
  "licensePlate": "DEF456",
  "year": 2022,
  "categoryId": null
}

### ============================================================
### 9. UPDATE VEHICLE (PUT)
### ============================================================
### @prompt updateId Enter vehicle ID to update:
PUT {{vehiclesUrl}}/2
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessToken}}

{
  "licensePlate": "GHI789",
  "year": 2025,
  "categoryId": 3
}

### ============================================================
### 10. DELETE VEHICLE (DELETE)
### ============================================================
### @prompt deleteId Enter vehicle ID to delete:
DELETE {{vehiclesUrl}}/20
Accept: application/json
Authorization: Bearer {{accessToken}}

### ============================================================
### 11. GET VEHICLE BY ID - Invalid (should return 404)
### ============================================================
GET {{vehiclesUrl}}/9999
Accept: application/json
Authorization: Bearer {{accessToken}}

### ============================================================
### 12. CREATE VEHICLE - Invalid data (validation errors)
### ============================================================
POST {{vehiclesUrl}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessToken}}

{
  "licensePlate": "A",  
  "year": 1800        
}

### ============================================================
### 13. CREATE VEHICLE - Duplicate license plate (should return 409)
### ============================================================
POST {{vehiclesUrl}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessToken}}

{
  "licensePlate": "ABC123", 
  "year": 2023,
  "categoryId": 1
}