### ============================================================
### CATEGORY API - HTTP Requests
### ============================================================
### 
### Base URL: http://localhost:8080/api/v1/categories
### 
### ============================================================

### Variables
@baseUrl = http://localhost:8080
@categoriesUrl = {{baseUrl}}/api/v1/categories

### 
@authBaseUrl = {{baseUrl}}/api/v1/auth


### ================================================================
### 1. LOGIN - Regular User
### ================================================================
# @name loginUser
POST {{authBaseUrl}}/login
Content-Type: application/json

{
    "email": "admin_regular@gmail.com",
    "password": "pass1234"
}

### 
@userToken = {{loginUser.response.body.data.accessToken}}
@userRefreshToken = {{loginUser.response.body.data.refreshToken}}

### ============================================================
### 1. GET ALL CATEGORIES
### ============================================================
GET {{categoriesUrl}}
Authorization: Bearer {{userToken}}

### ============================================================
### 2. GET CATEGORY BY ID
### ============================================================
### @prompt categoryId Enter category ID:
GET {{categoriesUrl}}/2
Authorization: Bearer {{userToken}}

### ============================================================
### 3. GET CATEGORY BY NAME
### ============================================================
### @prompt categoryName Enter category name:
GET {{categoriesUrl}}/name/Truck
Accept: application/json
Authorization: Bearer {{userToken}}

### ============================================================
### 4. CHECK IF CATEGORY EXISTS BY NAME
### ============================================================
### @prompt existsName Enter category name to check:
GET {{categoriesUrl}}/exists/Truck
Authorization: Bearer {{userToken}}

### ============================================================
### 5. CREATE CATEGORY
### ============================================================
POST {{categoriesUrl}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "name": "Sedan",
  "isActive": true
}

### ============================================================
### 9. UPDATE CATEGORY
### ============================================================
### @prompt updateCatId Enter category ID to update:
PUT {{categoriesUrl}}/5
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "name": "SUV Actualizado",
  "isActive": true
}

### ============================================================
### 10. DELETE CATEGORY
### ============================================================
### @prompt deleteCatId Enter category ID to delete:
DELETE {{categoriesUrl}}/5
Authorization: Bearer {{userToken}}

### ============================================================
### 11. CREATE CATEGORY - Duplicate (should return 409)
### ============================================================
POST {{categoriesUrl}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "name": "Truck",
  "isActive": true
}


### ============================================================
### 12. CREATE CATEGORY - Invalid name (too short)
### ============================================================
POST {{categoriesUrl}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{userToken}}

{
  "name": "A",
  "isActive": true
}