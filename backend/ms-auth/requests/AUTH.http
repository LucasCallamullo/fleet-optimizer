###   "error": "Invalid credentials",
###   "path": "/api/v1/auth/login"
### }
###
### CONFLICT (409):
### {
###   "status": 409,
###   "error": "Email already registered",
###   "path": "/api/v1/auth/register"
### }
### ================================================================