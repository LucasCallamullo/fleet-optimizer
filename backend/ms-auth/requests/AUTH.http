### ================================================================
### AUTH TESTS - ms-auth endpoints through Gateway
### ================================================================
### BASE URL: http://localhost:8080 (Gateway)
### ================================================================

@baseUrl = http://localhost:8080
@authBaseUrl = {{baseUrl}}/api/v1/auth

### ================================================================
### USERS FOR TESTING
### ================================================================
### Regular User:
###   Email: user_regular@gmail.com
###   Password: pass1234
###   Id: auth0|6aaf437b3de387c0d8f1e01e
###   Role: User
###
### Admin User:
###   Email: admin_regular@gmail.com
###   Password: pass1234
###   ID: auth0|6aaf44438c76f921189e4a85
###   Role: Admin
### ================================================================

### ================================================================
### 1. LOGIN - Regular User
### ================================================================
# @name loginUser
POST {{authBaseUrl}}/login
Content-Type: application/json

{
    "email": "user_regular@gmail.com",
    "password": "pass1234"
}

### ================================================================
### 2. LOGIN - Admin User
### ================================================================
# @name loginAdmin
POST {{authBaseUrl}}/login
Content-Type: application/json

{
    "email": "admin_regular@gmail.com",
    "password": "pass1234"
}

### ================================================================
### 3. REGISTER - New User
### ================================================================
POST {{authBaseUrl}}/register
Content-Type: application/json

{
    "email": "user_regular@gmail.com",
    "password": "pass1234",
    "firstName": "User",
    "lastName": "Test Regular"
}

### ================================================================
### 4. REGISTER - New Admin
### ================================================================
POST {{authBaseUrl}}/register
Content-Type: application/json

{
    "email": "admin_regular@gmail.com",
    "password": "pass1234",
    "firstName": "Super",
    "lastName": "Test Admin"
}

### ================================================================
### 5. REGISTER - Missing password (should fail 400)
### ================================================================
POST {{authBaseUrl}}/register
Content-Type: application/json

{
    "email": "invalid@test.com"
}

### ================================================================
### 6. REGISTER - Duplicate email (should fail 409)
### ================================================================
POST {{authBaseUrl}}/register
Content-Type: application/json

{
    "email": "user_regular@gmail.com",
    "password": "pass1234"
}

### ================================================================
### SAVE TOKENS FROM LOGIN RESPONSES
### ================================================================
@userToken = {{loginUser.response.body.data.accessToken}}
@userRefreshToken = {{loginUser.response.body.data.refreshToken}}
@adminToken = {{loginAdmin.response.body.data.accessToken}}
@adminRefreshToken = {{loginAdmin.response.body.data.refreshToken}}

### ================================================================
### 7. REFRESH TOKEN - Regular User
### ================================================================
POST {{authBaseUrl}}/refresh
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
    "refreshToken": "{{userRefreshToken}}"
}

### ================================================================
### 8. REFRESH TOKEN - Admin User
### ================================================================
POST {{authBaseUrl}}/refresh
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
    "refreshToken": "{{adminRefreshToken}}"
}

### ================================================================
### 9. REFRESH TOKEN - Invalid token (should fail 401)
### ================================================================
POST {{authBaseUrl}}/refresh
Content-Type: application/json

{
    "refreshToken": "invalid-token-123"
}

### ================================================================
### 10. LOGOUT - Regular User
### ================================================================
POST {{authBaseUrl}}/logout
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
    "refreshToken": "{{userRefreshToken}}"
}

### ================================================================
### 11. LOGOUT - Without refresh token (client-side only)
### ================================================================
POST {{authBaseUrl}}/logout
Content-Type: application/json
Authorization: Bearer {{userToken}}

{}

### ================================================================
### LOGIN WITH INVALID CREDENTIALS (should fail 401)
### ================================================================
POST {{authBaseUrl}}/login
Content-Type: application/json

{
    "email": "user_regular@gmail.com",
    "password": "wrongpassword"
}

### ================================================================
### LOGIN WITHOUT EMAIL (should fail 400)
### ================================================================
POST {{authBaseUrl}}/login
Content-Type: application/json

{
    "password": "pass1234"
}

### ================================================================
### LOGIN WITHOUT PASSWORD (should fail 400)
### ================================================================
POST {{authBaseUrl}}/login
Content-Type: application/json

{
    "email": "user_regular@gmail.com"
}

### ================================================================
### ================================================================
### EXPECTED RESPONSES SUMMARY
### ================================================================
### 
### SUCCESS (200/201):
### {
###   "accessToken": "eyJ...",
###   "refreshToken": "eyJ...",
###   "expiresIn": 300,
###   "user": {
###     "id": "...",
###     "username": "user_regular",
###     "email": "user_regular@gmail.com",
###     "name": null,
###     "givenName": null,
###     "familyName": null,
###     "emailVerified": false,
###     "roles": ["usuario"]
###   }
### }
