<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>com.fleetoptimizer</groupId>
    <artifactId>ms-auth</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ms-auth</name>
    <description>Authentication service for Fleet Optimization System</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- ================================================================
             SPRING BOOT STARTERS - Core framework dependencies
        -->
        
        <!-- WebFlux: Reactive web framework for non-blocking HTTP clients.
             Used for WebClient to call Keycloak asynchronously.
             Note: Uses Netty instead of Tomcat (reactive stack).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Security: Authentication and authorization framework.
             Provides @PreAuthorize, SecurityContext, and method-level security.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ================================================================
             UTILITY LIBRARIES
        -->
        
        <!-- Lombok: Reduces boilerplate code.
             Generates getters, setters, builders, and constructors at compile time.
             Annotations: @Data, @Builder, @Slf4j, @RequiredArgsConstructor.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Validation: Bean validation for DTOs.
             Provides @Valid, @NotNull, @Email, @Size annotations.
             Uses Jakarta Bean Validation 3.0 (JSR-380).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Jackson Databind: JSON serialization/deserialization.
             Required for parsing Keycloak API responses.
             Converts JSON to Java objects and vice versa.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ================================================================
             TESTING DEPENDENCIES
        -->
        
        <!-- Spring Boot Test: Comprehensive testing framework.
             Includes JUnit 5, Mockito, and Spring TestContext.
             Excludes vintage engine (JUnit 4) for clean JUnit 5 setup.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Reactor Test: Testing utilities for reactive streams.
             Provides StepVerifier for testing Flux/Mono sequences.
             Essential for testing reactive WebClient calls.
        -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security Test: Security testing utilities.
             Provides @WithMockUser and MockMvc security integration.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin: Configures annotation processing.
                 Required for Lombok to generate code at compile time.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Spring Boot Maven Plugin: Creates executable JAR.
                 Excludes Lombok from the final JAR (not needed at runtime).
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>