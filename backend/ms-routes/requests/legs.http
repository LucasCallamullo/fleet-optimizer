### ================================================================
### LEG ENDPOINTS
### ================================================================

@baseUrl = http://localhost:8080

@legBaseUrl = {{baseUrl}}/api/v1/legs

### ================================================================
### USERS FOR TESTING (Keycloak)
### ================================================================
### Regular User:
###   Email: user_regular@gmail.com
###   Password: pass1234
###   Role: usuario
###
### Admin User:
###   Email: admin_regular@gmail.com
###   Password: pass1234
###   Role: admin
### ================================================================

### ================================================================
### 1. LOGIN - Get JWT Token (via Gateway)
### ================================================================
# @name loginUser
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
    "email": "user_regular@gmail.com",
    "password": "pass1234"
}

### ================================================================
### 2. SAVE TOKEN
### ================================================================
@accessToken = {{loginUser.response.body.accessToken}}
@refreshToken = {{loginUser.response.body.refreshToken}}


### Get Leg by ID
GET {{legBaseUrl}}/2
Content-Type: application/json
Authorization: Bearer {{accessToken}}

### Get Legs by Route ID
GET {{legBaseUrl}}/route/1
Content-Type: application/json
Authorization: Bearer {{accessToken}}

### Update Leg
PUT {{legBaseUrl}}/1
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "sequence": 1,
  "vehicleId": 20,
  "packageId": 200,
  "origin": {
    "street": "Av. Libertador",
    "streetNumber": "1500",
    "city": "Buenos Aires",
    "state": "CABA",
    "country": "Argentina",
    "postalCode": "1000",
    "latitude": -34.6037,
    "longitude": -58.3816
  },
  "destination": {
    "street": "Av. Colon",
    "streetNumber": "700",
    "city": "Cordoba",
    "state": "Cordoba",
    "country": "Argentina",
    "postalCode": "5000",
    "latitude": -31.4201,
    "longitude": -64.1888
  }
}

### Delete Leg
DELETE {{legBaseUrl}}/1
Content-Type: application/json