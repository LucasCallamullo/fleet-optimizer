### ================================================================
### SHIPMENT ENDPOINTS - ms-routes
### BASE URL: http://localhost:8080 (ms-routes directo)
### O via Gateway: http://localhost:8080
### ================================================================

@baseUrl = http://localhost:8080
@gatewayUrl = http://localhost:8080
@shipmentBaseUrl = {{baseUrl}}/api/v1/shipments

### ================================================================
### USERS FOR TESTING (Keycloak)
### ================================================================
### Regular User:
###   Email: user_regular@gmail.com
###   Password: pass1234
###   Role: usuario
###
### Admin User:
###   Email: admin_regular@gmail.com
###   Password: pass1234
###   Role: admin
### ================================================================

### ================================================================
### 1. LOGIN - Get JWT Token (via Gateway)
### ================================================================
# @name loginUser
POST {{gatewayUrl}}/api/v1/auth/login
Content-Type: application/json

{
    "email": "user_regular@gmail.com",
    "password": "pass1234"
}

### ================================================================
### 2. SAVE TOKEN
### ================================================================
@accessToken = {{loginUser.response.body.accessToken}}
@refreshToken = {{loginUser.response.body.refreshToken}}

### ================================================================
### 3. CREATE SHIPMENT - Via ms-routes directo
### ================================================================
# @name createShipment
POST {{shipmentBaseUrl}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "packageIds": [1, 2],
    "vehicleId": 1,
    "destination": {
        "street": "Av. Colon",
        "streetNumber": "500",
        "city": "Cordoba",
        "state": "Cordoba",
        "country": "Argentina",
        "postalCode": "5000",
        "latitude": -31.4201,
        "longitude": -64.1888
    }
}

### ================================================================
### 4. CREATE SHIPMENT - Multiple packages (3 packages)
### ================================================================
POST {{shipmentBaseUrl}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "packageIds": [1, 2, 3],
    "vehicleId": 2,
    "destination": {
        "street": "Av. San Martin",
        "streetNumber": "100",
        "city": "Mendoza",
        "state": "Mendoza",
        "country": "Argentina",
        "postalCode": "5500",
        "latitude": -32.8908,
        "longitude": -68.8272
    }
}

### ================================================================
### 5. CREATE SHIPMENT - Single package
### ================================================================
POST {{shipmentBaseUrl}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "packageIds": [1],
    "vehicleId": 1,
    "destination": {
        "street": "Av. Libertador",
        "streetNumber": "1000",
        "city": "Buenos Aires",
        "state": "CABA",
        "country": "Argentina",
        "postalCode": "1000",
        "latitude": -34.6037,
        "longitude": -58.3816
    }
}

### ================================================================
### 6. CREATE SHIPMENT - With invalid vehicle (should fail 404)
### ================================================================
POST {{shipmentBaseUrl}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "packageIds": [1, 2],
    "vehicleId": 999,
    "destination": {
        "street": "Av. Colon",
        "streetNumber": "500",
        "city": "Cordoba",
        "state": "Cordoba",
        "country": "Argentina",
        "postalCode": "5000",
        "latitude": -31.4201,
        "longitude": -64.1888
    }
}

### ================================================================
### 7. CREATE SHIPMENT - With empty packages (should fail 400)
### ================================================================
POST {{shipmentBaseUrl}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "packageIds": [],
    "vehicleId": 1,
    "destination": {
        "street": "Av. Colon",
        "streetNumber": "500",
        "city": "Cordoba",
        "state": "Cordoba",
        "country": "Argentina",
        "postalCode": "5000",
        "latitude": -31.4201,
        "longitude": -64.1888
    }
}

### ================================================================
### 8. CREATE SHIPMENT - Without authentication (should fail 401)
### ================================================================
POST {{shipmentBaseUrl}}
Content-Type: application/json

{
    "packageIds": [1, 2],
    "vehicleId": 1,
    "destination": {
        "street": "Av. Colon",
        "streetNumber": "500",
        "city": "Cordoba",
        "state": "Cordoba",
        "country": "Argentina",
        "postalCode": "5000",
        "latitude": -31.4201,
        "longitude": -64.1888
    }
}

### ================================================================
### 9. CREATE SHIPMENT - With invalid token (should fail 401)
### ================================================================
POST {{shipmentBaseUrl}}
Content-Type: application/json
Authorization: Bearer invalid.token.here

{
    "packageIds": [1, 2],
    "vehicleId": 1,
    "destination": {
        "street": "Av. Colon",
        "streetNumber": "500",
        "city": "Cordoba",
        "state": "Cordoba",
        "country": "Argentina",
        "postalCode": "5000",
        "latitude": -31.4201,
        "longitude": -64.1888
    }
}

### ================================================================
### 10. CREATE SHIPMENT - Via Gateway (if ms-routes directo no funciona)
### ================================================================
POST {{gatewayUrl}}/api/v1/shipments
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "packageIds": [1, 2],
    "vehicleId": 1,
    "destination": {
        "street": "Av. Colon",
        "streetNumber": "500",
        "city": "Cordoba",
        "state": "Cordoba",
        "country": "Argentina",
        "postalCode": "5000",
        "latitude": -31.4201,
        "longitude": -64.1888
    }
}

