<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- ================================================================
	     PARENT: Spring Boot Starter Parent
	     ================================================================
	     Provides base configuration and dependency management.
	     Version 3.2.12 is the latest stable from the 3.2.x branch.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.12</version>
		<relativePath />
	</parent>

	<!-- ================================================================
	     PROJECT METADATA
	-->
	<groupId>com.fleetoptimizer</groupId>
	<artifactId>ms-routes</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<!-- ================================================================
	     PROPERTIES
	     ================================================================
	     Defines Java version and library versions for consistency.
	-->
	<properties>
		<java.version>17</java.version>
		<org.mapstruct.version>1.6.3</org.mapstruct.version>
		<lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
		<maven-surefire-plugin.version>3.5.0</maven-surefire-plugin.version>
	</properties>

	<!-- ================================================================
	     DEPENDENCIES
	-->
	<dependencies>

		<!-- ================================================================
		     SPRING BOOT STARTERS
		-->

		<!-- Spring Boot Web: REST APIs with Tomcat embedded.
		     Provides: @RestController, @RequestMapping, and HTTP support.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Data JPA: ORM with Hibernate.
		     Provides: @Entity, @Repository, and JPA query methods.
		     Required for database operations.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- ================================================================
		     DATABASE DRIVERS
		-->

		<!-- PostgreSQL Driver: Production database connectivity.
		     Active by default - used when running with PostgreSQL.
		     Scope: runtime (needed only when the app runs).
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- H2 Database: In-memory database for testing only.
		     Used in integration tests with test containers.
		     Not included in production builds.
		     Scope: test (not packaged in production JAR).
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- ================================================================
		     UTILITY LIBRARIES
		-->

		<!-- Lombok: Reduces boilerplate code.
		     Annotations: @Data, @Builder, @Slf4j, @RequiredArgsConstructor.
		     Generates code at compile time.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Bean Validation: DTO validation.
		     Annotations: @Valid, @NotNull, @NotBlank, @Size, @Min, @Max.
		     Uses Hibernate Validator (Jakarta Bean Validation 3.0).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- ================================================================
		     API DOCUMENTATION
		-->

		<!-- Swagger / OpenAPI: Auto-generates API documentation.
		     Access UI at: http://localhost:8082/swagger-ui.html
		     Generates docs from @RestController and DTOs.
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.6.0</version>
		</dependency>

		<!-- ================================================================
		     MAPPING
		-->

		<!-- MapStruct: Compile-time DTO to Entity mapping.
		     No reflection - generates type-safe code at compile time.
		     Use with: @Mapper(componentModel = "spring").
		     Faster than ModelMapper and other runtime mappers.
		-->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${org.mapstruct.version}</version>
		</dependency>

		<!-- Lombok-MapStruct Binding: Bridges Lombok and MapStruct.
		     Allows MapStruct to recognize Lombok-generated getters/setters.
		     Required for MapStruct to work with @Data and @Builder.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok-mapstruct-binding</artifactId>
			<version>${lombok-mapstruct-binding.version}</version>
		</dependency>

		<!-- ================================================================
		     SECURITY
		-->

		<!-- Spring Security: Authentication and authorization.
		     Provides @PreAuthorize, SecurityContext, and method-level security.
		     Required for role-based access control (RBAC).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- ================================================================
		     SPRING CLOUD - Feign Clients
		     ================================================================
		     OpenFeign: Declarative REST client for calling other microservices.
		     Used to call ms-fleets, ms-packages, and ms-geocoding.
		     Provides @FeignClient for type-safe HTTP calls.
		-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-openfeign</artifactId>
			<version>4.1.0</version>
		</dependency>

		<!-- Spring Cloud Commons: Core Spring Cloud utilities.
		     Required for Feign and service discovery integration.
		-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-commons</artifactId>
			<version>4.1.0</version>
		</dependency>

		<!-- ================================================================
		     TESTING
		-->

		<!-- Spring Boot Test: Comprehensive testing framework.
		     Includes: JUnit 5, Mockito, AssertJ, and TestContext.
		     Excludes JUnit 4 vintage engine for clean JUnit 5 setup.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>org.junit.vintage</groupId>
					<artifactId>junit-vintage-engine</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- Spring Security Test: Security testing utilities.
		     Provides @WithMockUser for integration tests.
		     Simulates authenticated users without Keycloak.
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<!-- ================================================================
	     BUILD CONFIGURATION
	-->
	<build>
		<plugins>

			<!-- Spring Boot Maven Plugin: Creates executable JAR.
				 Excludes Lombok from the final JAR (not needed at runtime).
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!-- Maven Compiler Plugin: Processes annotations at compile time.
				 Order matters: Lombok MUST run before MapStruct.
				 
				 Annotation processors:
				 1. Lombok - generates getters, setters, builders, logs
				 2. Lombok-MapStruct-Binding - bridges annotations
				 3. MapStruct - generates mapper implementations
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>17</source>
					<target>17</target>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>${lombok-mapstruct-binding.version}</version>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${org.mapstruct.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<!-- Maven Surefire Plugin: Runs unit tests.
				 Includes test files ending with *Test.java or *Tests.java.
				 Excludes integration tests (*IT.java) from unit test runs.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven-surefire-plugin.version}</version>
				<configuration>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
					</includes>
				</configuration>
			</plugin>

			<!-- Maven Failsafe Plugin: Runs integration tests.
				 Separate phase from unit tests.
				 Runs during integration-test and verify phases.
				 Includes test files ending with *IT.java or *IntegrationTest.java.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<includes>
						<include>**/*IT.java</include>
						<include>**/*IntegrationTest.java</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

</project>