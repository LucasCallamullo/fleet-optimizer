<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================
         PARENT: Spring Boot Starter Parent
         ================================================================
         Provides base configuration and dependency management.
         Version 3.2.12 is the latest stable from the 3.2.x branch.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <!-- ================================================================
         PROJECT METADATA
    -->
    <groupId>com.fleetoptimizer</groupId>
    <artifactId>ms-geocoding</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ms-geocoding</name>
    <description>Geocoding service for route calculation using OSRM</description>

    <!-- ================================================================
         PROPERTIES
         ================================================================
         Defines Java version for the project.
    -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- ================================================================
         DEPENDENCIES
         ================================================================
    -->

    <dependencies>

        <!-- ================================================================
             SPRING BOOT STARTERS
        -->

        <!-- Spring Boot Web: REST APIs with Tomcat embedded.
             Provides: @RestController, @RequestMapping, and HTTP support.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- WebFlux: Reactive web framework for non-blocking HTTP clients.
             Used for WebClient to call OSRM API asynchronously.
             Note: Uses Netty in addition to Tomcat for reactive clients.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- ================================================================
             UTILITY LIBRARIES
        -->

        <!-- Lombok: Reduces boilerplate code.
             Generates getters, setters, builders, and constructors at compile time.
             Annotations: @Data, @Builder, @Slf4j, @RequiredArgsConstructor.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Validation: Bean validation for DTOs.
             Provides @Valid, @NotNull, @Min, @Max annotations.
             Uses Jakarta Bean Validation 3.0 (JSR-380).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ================================================================
             API DOCUMENTATION
        -->

        <!-- Swagger / OpenAPI: Auto-generates API documentation.
             Access UI at: http://localhost:8085/swagger-ui.html
             Generates docs from @RestController and DTOs.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- ================================================================
             TESTING
             ================================================================
             NOTE: ms-geocoding does NOT use a database.
             No JPA, Hibernate, PostgreSQL, or H2 dependencies needed.
             All data comes from the OSRM API.
        -->

        <!-- Spring Boot Test: Comprehensive testing framework.
             Includes JUnit 5, Mockito, and Spring TestContext.
             Excludes vintage engine (JUnit 4) for clean JUnit 5 setup.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

    </dependencies>

    <!-- ================================================================
         BUILD CONFIGURATION
    -->
    <build>
        <plugins>

            <!-- Spring Boot Maven Plugin: Creates executable JAR.
                 Excludes Lombok from the final JAR (not needed at runtime).
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>